<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TaskManagement.Mobile.AboutPage"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#FFFFFF">

	<ScrollView>

		<VerticalStackLayout
            Padding="24"
            Spacing="24">

			<!-- Header -->

			<VerticalStackLayout Spacing="8">

				<Label
                    Text="About"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="#2563EB" />

				<Label
                    Text="Task Management"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="#111827" />

				<Label
                    Text="Mobile Application"
                    FontSize="16"
                    TextColor="#6B7280" />

			</VerticalStackLayout>


			<!-- Divider -->

			<BoxView
                HeightRequest="1"
                Color="#E5E7EB" />


			<!-- Description Card -->

			<Border
                Stroke="#E5E7EB"
                StrokeThickness="1"
                BackgroundColor="#F9FAFB"
                Padding="18">

				<Border.StrokeShape>
					<RoundRectangle CornerRadius="10" />
				</Border.StrokeShape>

				<VerticalStackLayout Spacing="10">

					<Label
                        Text="About the Application"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#111827" />

					<Label
                        Text="This application provides a mobile interface for the Task Management System through a hybrid WebView experience."
                        FontSize="15"
                        TextColor="#4B5563"
                        LineBreakMode="WordWrap" />

				</VerticalStackLayout>

			</Border>


			<!-- Technology -->

			<VerticalStackLayout Spacing="14">

				<Label
                    Text="Technology"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#111827" />

				<VerticalStackLayout Spacing="10">

					<Border
                        Stroke="#E5E7EB"
                        StrokeThickness="1"
                        BackgroundColor="#FFFFFF"
                        Padding="14">

						<Border.StrokeShape>
							<RoundRectangle CornerRadius="8" />
						</Border.StrokeShape>

						<Label
                            Text=".NET MAUI"
                            FontSize="15"
                            TextColor="#374151" />

					</Border>

					<Border
                        Stroke="#E5E7EB"
                        StrokeThickness="1"
                        BackgroundColor="#FFFFFF"
                        Padding="14">

						<Border.StrokeShape>
							<RoundRectangle CornerRadius="8" />
						</Border.StrokeShape>

						<Label
                            Text="Vue.js"
                            FontSize="15"
                            TextColor="#374151" />

					</Border>

					<Border
                        Stroke="#E5E7EB"
                        StrokeThickness="1"
                        BackgroundColor="#FFFFFF"
                        Padding="14">

						<Border.StrokeShape>
							<RoundRectangle CornerRadius="8" />
						</Border.StrokeShape>

						<Label
                            Text="ASP.NET Core Web API"
                            FontSize="15"
                            TextColor="#374151" />

					</Border>

					<Border
                        Stroke="#E5E7EB"
                        StrokeThickness="1"
                        BackgroundColor="#FFFFFF"
                        Padding="14">

						<Border.StrokeShape>
							<RoundRectangle CornerRadius="8" />
						</Border.StrokeShape>

						<Label
                            Text="JWT Authentication"
                            FontSize="15"
                            TextColor="#374151" />

					</Border>

				</VerticalStackLayout>

			</VerticalStackLayout>


			<!-- Back Button -->

			<Button
                Text="Back to Application"
                Clicked="OnBackToApplicationClicked"
                BackgroundColor="#2563EB"
                TextColor="White"
                FontSize="15"
                FontAttributes="Bold"
                CornerRadius="8"
                HeightRequest="50"
                Margin="0,4,0,0" />

		</VerticalStackLayout>

	</ScrollView>

</ContentPage>
